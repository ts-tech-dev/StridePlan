<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kadence uses your location during runs to measure distance, pace and splits, and to draw your route.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Kadence reads your heart rate to show averages in your run summaries.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Kadence saves your completed runs to Apple Health as running workouts with routes.</string>
	<key>NSMotionUsageDescription</key>
	<string>Kadence uses your steps to estimate distance and pace on treadmill runs.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kadence uses Bluetooth to send workouts to your Garmin watch and receive the runs you record on it.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Garmin Connect IQ</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Must match GarminService.urlScheme. Garmin Connect returns the chosen watch here. -->
				<string>strideplan-ciq</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>gcm-ciq</string>
	</array>
	<!-- Only standard HTTPS/OS encryption: skips the export-compliance question on every TestFlight build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
